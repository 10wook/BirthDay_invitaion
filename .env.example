# 호스트 / 파티 정보
NEXT_PUBLIC_HOST_NAME=한영욱
NEXT_PUBLIC_PARTY_TITLE=Birthday Party
NEXT_PUBLIC_EVENT_DATE=2026-06-15T18:00:00+09:00
NEXT_PUBLIC_EVENT_DATE_DISPLAY=2026년 6월 15일 (일)
NEXT_PUBLIC_EVENT_TIME=오후 6시

# 장소
NEXT_PUBLIC_VENUE=서울 강남구
NEXT_PUBLIC_VENUE_NAME=The Garden Terrace
NEXT_PUBLIC_ADDRESS=서울특별시 강남구 테헤란로 123, 3층

# 미디어 경로 (public 폴더 기준)
NEXT_PUBLIC_HERO_VIDEO_SRC=/videos/hero-bg.mp4
